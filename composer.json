{
    "name": "ljrodmar/enzona",
    "description": "Cliente Laravel para la API de pagos de Enzona",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "illuminate/database": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Macroseso\\Enzona\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Macroseso\\Enzona\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Macroseso\\Enzona\\EnzonaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
