{
    "name": "ljrodmar/enzona",
    "description": "Cliente Laravel para la API de pagos de Enzona",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Macroseso\\Enzona\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Macroseso\\Enzona\\EnzonaServiceProvider"
            ]
        }
    }
}
